          "name": "02 Seed Admin Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "const json = pm.response.json();",
                  "pm.test('User role is ADMIN', function () {",
                  "  pm.expect(json.user.role).to.eql('ADMIN');",
                  "});",
                  "if (json.accessToken) {",
                  "  pm.environment.set('adminAccessToken', json.accessToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
