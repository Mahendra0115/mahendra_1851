      "name": "02 POST /users/login - Seed Admin Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 201', function () {",
              "  pm.response.to.have.status(201);",
              "});",
              "const json = pm.response.json();",
              "pm.test('User role is ADMIN and brandId is null', function () {",
              "  pm.expect(json.user.role).to.eql('ADMIN');",
              "  pm.expect(json.user.brandId).to.eql(null);",
              "});",
              "if (json.accessToken) {",
              "  pm.environment.set('adminAccessToken', json.accessToken);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
