    {
      "name": "Auth",
      "item": [
        {
          "name": "POST /users/signup - Brand Signup",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "pm.test('Signup returns access token and user', function () {",
                  "  pm.expect(json).to.have.property('accessToken');",
                  "  pm.expect(json).to.have.property('user');",
                  "});",
                  "",
                  "if (json.accessToken) {",
                  "  pm.environment.set('accessToken', json.accessToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{brandEmail}}\",\n  \"password\": \"{{brandPassword}}\",\n  \"fullName\": \"{{brandFullName}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/users/signup",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "signup"
              ]
            },
            "description": "Creates a BRAND user and returns accessToken + user. If the email already exists, API returns 409 Conflict."
          },
          "response": []
        },
        {
          "name": "POST /users/login - Brand Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
